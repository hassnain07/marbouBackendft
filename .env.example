NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://marbou:marbou@localhost:5433/marbou

# JWT secrets (must be 32+ chars in production)
JWT_USER_SECRET=change-me-to-a-random-32-plus-char-secret-here
JWT_ADMIN_SECRET=change-me-admin-to-a-random-32-plus-char-secret

# OTP
OTP_PEPPER=change-me-otp-pepper-32-plus-chars-here

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Public URLs
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Cron
RUN_CRON=true

# Rate limits (per minute per IP)
RATE_LIMIT_STRICT_PER_MIN=200
RATE_LIMIT_NORMAL_PER_MIN=2000

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=http://localhost:4000/files

# Email
EMAIL_DRIVER=console
SMTP_URL=

# SMS / WhatsApp
SMS_DRIVER=mock
WHATSAPP_DRIVER=mock

# Social auth
AUTH_MOCK=true
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
APPLE_CLIENT_ID=

# Admin TOTP (dev only - refused in production)
DEV_TOTP_FIXED_CODE=000000

# Dev helpers (refused in production)
DEV_HELPERS=true

# Trust proxy (set to 1 or loopback behind nginx/load balancer)
TRUST_PROXY=

# Seed
SEED_ADMIN_EMAIL=admin@marbou.test
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_DEMO_ADMINS=true

# Analytics
ANALYTICS_SALT=change-me-analytics-salt-32-plus-chars-here

# Admin token encryption key (AES-256 for TOTP secret)
ADMIN_TOTP_ENC_KEY=change-me-totp-enc-key-32-plus-chars-here

# Sentry (optional)
SENTRY_DSN=
