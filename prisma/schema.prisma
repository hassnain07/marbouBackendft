generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_DELETION
}

enum Capability {
  SELLER
  DEALER
  EMPLOYER
  SERVICE_PROVIDER
  CANDIDATE
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_MODERATOR
  SUPPORT_AGENT
  FINANCIAL_AUDITOR
}

enum Language {
  AR
  EN
}

enum Currency {
  SDG
  USD
}

enum OtpPurpose {
  REGISTER
  RESET
  CHANGE_EMAIL
  PHONE
  DELETE_ACCOUNT
}

enum OtpChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum ListingType {
  SALE
  RENT
  WANTED
  SERVICE
  JOB
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  HIDDEN
  AUTO_HIDDEN
  SUSPENDED
  SOLD
  EXPIRED
  ARCHIVED
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
  DATE
  RANGE
  FILE_URL
}

enum PlaceLevel {
  STATE
  CITY
  NEIGHBORHOOD
}

// ─── Identity & Access ───────────────────────────────────────────────────────

model User {
  id                   String          @id @default(uuid())
  email                String?         @unique
  emailVerifiedAt      DateTime?
  phone                String?
  verifiedPhone        String?         @unique
  passwordHash         String?
  fullName             String
  avatarUrl            String?
  coverUrl             String?
  bio                  String?
  city                 String?
  countryCode          String          @default("SD")
  languages            String[]        @default([])
  contactPrefs         Json            @default("{\"call\":true,\"whatsapp\":true,\"chatOnly\":false}")
  language             Language        @default(AR)
  status               AccountStatus   @default(ACTIVE)
  statusReason         String?
  statusUntil          DateTime?
  capabilities         Capability[]    @default([])
  badges               String[]        @default([])
  notifPrefs           Json            @default("{}")
  deviceTokens         Json            @default("[]")
  employerProfile      Json?
  serviceProfile       Json?
  ratingAvg            Float           @default(0)
  ratingCount          Int             @default(0)
  responseRate         Float?
  avgResponseMin       Int?
  fraudScore           Int             @default(0)
  lastActiveAt         DateTime        @default(now())
  deactivatedAt        DateTime?
  deletionRequestedAt  DateTime?
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  sessions             Session[]
  otpCodes             OtpCode[]
  loginEvents          LoginEvent[]
  socialIdentities     SocialIdentity[]
  verificationRequests VerificationRequest[]
  blocksGiven          BlockedUser[]   @relation("blocker")
  blocksReceived       BlockedUser[]   @relation("blocked")
  analyticsEvents      AnalyticsEvent[]
  listings             Listing[]

  @@index([email])
  @@index([status])
}

model Session {
  id              String    @id @default(uuid())
  userId          String
  familyId        String
  refreshHash     String    @unique
  prevRefreshHash String?
  deviceId        String?
  deviceName      String?
  os              String?
  ip              String?
  approxLocation  String?
  lastActiveAt    DateTime  @default(now())
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OtpCode {
  id        String      @id @default(uuid())
  email     String?
  phone     String?
  userId    String?
  purpose   OtpPurpose
  channel   OtpChannel
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  sentAt    DateTime    @default(now())
  createdAt DateTime    @default(now())

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose])
  @@index([phone, purpose])
}

model LoginEvent {
  id         String   @id @default(uuid())
  userId     String?
  email      String
  outcome    String
  ip         String
  deviceId   String?
  deviceName String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
}

model SocialIdentity {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model AdminUser {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  fullName           String
  role               AdminRole
  totpSecretEnc      String?
  totpEnrolledAt     DateTime?
  ipAllowlist        String[]  @default([])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model VerificationRequest {
  id           String    @id @default(uuid())
  userId       String
  kind         String
  documentKeys String[]  @default([])
  status       String    @default("PENDING")
  reason       String?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// ─── Config & Catalog ────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model ExchangeRate {
  id            String   @id @default(uuid())
  base          String
  quote         String
  rate          Decimal  @db.Decimal(18, 6)
  effectiveFrom DateTime @default(now())
  setBy         String?
  createdAt     DateTime @default(now())

  @@index([base, quote, effectiveFrom])
}

model Translation {
  id        String   @id @default(uuid())
  key       String
  lang      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, lang])
  @@index([lang])
}

// ─── Media ───────────────────────────────────────────────────────────────────

model MediaAsset {
  id          String        @id @default(uuid())
  ownerId     String
  kind        String
  isPrivate   Boolean       @default(false)
  key         String        @unique
  url         String?
  thumbKeys   Json?
  sizeBytes   Int
  mime        String
  width       Int?
  height      Int?
  durationSec Int?
  sha256      String?
  attachedAt  DateTime?
  createdAt   DateTime      @default(now())

  listingMedia ListingMedia[]

  @@index([ownerId])
  @@index([attachedAt])
  @@index([sha256])
}

// ─── Audit & Analytics ───────────────────────────────────────────────────────

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorType String
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  type       String
  userHash   String?
  deviceHash String?
  listingId  String?
  categoryId String?
  cityId     String?
  actorKey   String?
  props      Json     @default("{}")
  userId     String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([listingId, type, createdAt])
}

// ─── Geo ─────────────────────────────────────────────────────────────────────

model Place {
  id           String     @id @default(uuid())
  level        PlaceLevel
  parentId     String?
  countryCode  String     @default("SD")
  nameAr       String
  nameEn       String
  lat          Float?
  lng          Float?
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())

  parent      Place?     @relation("PlaceTree", fields: [parentId], references: [id])
  children    Place[]    @relation("PlaceTree")

  @@index([level, countryCode])
  @@index([parentId])
}

// ─── Category ────────────────────────────────────────────────────────────────

model Category {
  id                String              @id @default(uuid())
  slug              String              @unique
  parentId          String?
  nameAr            String
  nameEn            String
  descriptionAr     String?
  descriptionEn     String?
  iconUrl           String?
  schemaVersion     Int                 @default(1)
  postingRestricted Boolean             @default(false)
  postingMessage    String?
  expiryDays        Int?
  supportsCompare   Boolean             @default(false)
  isVideoAllowed    Boolean             @default(true)
  isActive          Boolean             @default(true)
  isArchived        Boolean             @default(false)
  displayOrder      Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  parent            Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[]          @relation("CategoryTree")
  attributes        CategoryAttribute[]
  listings          Listing[]

  @@index([parentId])
  @@index([isActive, isArchived])
  @@index([displayOrder])
}

model CategoryAttribute {
  id              String        @id @default(uuid())
  categoryId      String
  attributeKey    String
  labelAr         String
  labelEn         String
  dataType        AttributeType
  isRequired      Boolean       @default(false)
  isPrivate       Boolean       @default(false)
  isFilterable    Boolean       @default(false)
  isSearchable    Boolean       @default(false)
  promoteToIndex  Boolean       @default(false)
  showInCompare   Boolean       @default(false)
  optionsList     Json?
  validationRules Json?
  dependsOn       String?
  displayOrder    Int           @default(0)
  isArchived      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeKey])
  @@index([categoryId])
  @@index([displayOrder])
}

// ─── Listings ────────────────────────────────────────────────────────────────

model Listing {
  id                String        @id @default(uuid())
  publicSeq         Int           @unique @default(autoincrement())
  ownerId           String
  businessId        String?
  countryCode       String        @default("SD")
  cityId            String?
  neighborhoodId    String?
  categoryId        String
  listingType       ListingType
  title             String
  description       String
  searchText        String        @default("")
  price             Decimal?      @db.Decimal(18, 2)
  budgetMin         Decimal?      @db.Decimal(18, 2)
  budgetMax         Decimal?      @db.Decimal(18, 2)
  currency          String        @default("SDG")
  isNegotiable      Boolean       @default(false)
  condition         String?
  status            ListingStatus @default(DRAFT)
  statusReason      String?
  isCustomOther     Boolean       @default(false)
  customOtherText   String?
  lat               Float?
  lng               Float?
  pubLat            Float?
  pubLng            Float?
  locationName      String?
  isApproxLocation  Boolean       @default(false)
  approxRadiusM     Int?
  contactOptions    Json          @default("{\"call\":true,\"whatsapp\":true,\"chat\":true}")
  dynamicAttributes Json          @default("{}")
  qualityScore      Int           @default(0)
  riskScore         Int           @default(0)
  scan              Json?
  viewCount         Int           @default(0)
  favoriteCount     Int           @default(0)
  leadCount         Int           @default(0)
  videoMediaId      String?
  videoUrl          String?
  videoPosterUrl    String?
  vehicleVin        String?
  ownershipDocKey   String?
  reminded7         Boolean       @default(false)
  reminded1         Boolean       @default(false)
  publishedAt       DateTime?
  expiresAt         DateTime?
  soldAt            DateTime?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  owner             User          @relation(fields: [ownerId], references: [id])
  category          Category      @relation(fields: [categoryId], references: [id])
  media             ListingMedia[]
  views             ListingView[]

  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([ownerId, status])
  @@index([cityId, status])
  @@index([pubLat, pubLng])
}

model ListingMedia {
  id        String     @id @default(uuid())
  listingId String
  mediaId   String
  url       String
  thumbUrl  String?
  position  Int        @default(0)
  isCover   Boolean    @default(false)
  hash      String?
  createdAt DateTime   @default(now())

  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([listingId])
  @@index([mediaId])
}

model ListingView {
  id        String   @id @default(uuid())
  listingId String
  viewerKey String
  day       String
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, viewerKey, day])
  @@index([listingId])
}
